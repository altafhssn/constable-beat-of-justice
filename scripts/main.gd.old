class_name main
extends Node2D

# CONSTABLE: BEAT OF JUSTICE — Core Game Manager
# Indian Police Roguelike (Godot 4.6)

# ─── Constants ───
const TILE_SIZE = 32
const MAP_WIDTH = 40
const MAP_HEIGHT = 40
const MAX_FLOORS = 25
const FOV_RADIUS = 8

# Zone definitions
const ZONES = [
	{ "name": "Basti - Slums", "floor": 1, "floor_color": Color("#3a3020"), "wall_color": Color("#4a3a2a") },
	{ "name": "Bazaar - Market", "floor": 6, "floor_color": Color("#4a2828"), "wall_color": Color("#5a3830") },
	{ "name": "Naka - Checkpost", "floor": 11, "floor_color": Color("#2a2a30"), "wall_color": Color("#3a3a45") },
	{ "name": "Kothi - Mansion", "floor": 16, "floor_color": Color("#1a1a28"), "wall_color": Color("#2a2a3a") },
	{ "name": "Commissioner's Office", "floor": 21, "floor_color": Color("#1a0a0a"), "wall_color": Color("#2a0a0a") }
]

const RANKS = [
	"Constable", "Head Constable", "Assistant SI", "Sub Inspector", "Inspector",
	"DSP", "ASP", "SP", "DIG", "IG", "Commissioner"
]

const ENEMY_TYPES = ["pickpocket", "thug", "pickpocket", "thug", "smuggler", "guard", "hitman", "elite"]

const BOSS_NAMES = {
	5: "Gunda King", 10: "Hawala Don", 15: "Border Lord", 20: "Minister Sahib", 25: "The Commissioner"
}

const CIVILIAN_TYPES = ["chai_wala", "news_boy", "teacher", "nurse", "auto_driver"]
const CIVILIAN_NAMES = {
	"chai_wala": "Chai Wala", "news_boy": "News Boy", "teacher": "Teacher",
	"nurse": "Nurse", "auto_driver": "Auto Driver"
}
const CIVILIAN_BUFFS = {
	"chai_wala": "Restore 3 HP", "news_boy": "+5 XP",
	"teacher": "Knowledge (XP boost)", "nurse": "+5 Max HP",
	"auto_driver": "+1 Movement"
}

# ─── State ───
var player: Dictionary = {
	"x": 0, "y": 0,
	"hp": 20, "max_hp": 20,
	"atk": 5, "def": 2,
	"xp": 0, "xp_next": 25,
	"level": 1,
	"floor": 1,
	"gold": 0,
	"kills": 0,
	"civilians_rescued": 0,
	"warrants": [],
	"inventory": []
}

var map_data = []
var enemies = []
var civilians = []
var items = []
var explored = []
var visible = []
var stair_x = 0
var stair_y = 0
var game_over = false
var waiting_for_input = true
var turn_count = 0
var message_queue = []

# Grid movement for turn-based
var move_dir = Vector2.ZERO
var can_act = true

func _ready():
	init_dungeon(1)
	# TODO: Set up tilemap, sprites, HUD
	print("Constable: Beat of Justice — Game initialized on floor ", player.floor)

func init_dungeon(floor_num: int):
	map_data.clear()
	enemies.clear()
	civilians.clear()
	items.clear()
	explored.clear()
	
	# Initialize maps
	for x in range(MAP_WIDTH):
		map_data.append([])
		explored.append([])
		visible.append([])
		for y in range(MAP_HEIGHT):
			map_data[x].append(1)  # 1 = wall
			explored[x].append(false)
			visible[x].append(false)
	
	# ——— Room generation (BSP-like) ———
	var rooms = []
	var num_rooms = 6 + randi() % 5
	
	for attempt in range(100):
		if rooms.size() >= num_rooms:
			break
		
		var rw = 5 + randi() % 8
		var rh = 5 + randi() % 8
		var rx = 1 + randi() % (MAP_WIDTH - rw - 2)
		var ry = 1 + randi() % (MAP_HEIGHT - rh - 2)
		
		var overlap = false
		for r in rooms:
			if rx < r.x + r.w + 1 and rx + rw + 1 > r.x and ry < r.y + r.h + 1 and ry + rh + 1 > r.y:
				overlap = true
				break
		if overlap:
			continue
		
		# Carve room
		for x in range(rx, rx + rw):
			for y in range(ry, ry + rh):
				map_data[x][y] = 0
		
		# Connect to previous room
		if rooms.size() > 0:
			var prev = rooms[-1]
			var px = prev.x + prev.w / 2
			var py = prev.y + prev.h / 2
			var cx = rx + rw / 2
			var cy = ry + rh / 2
			
			var step_x = 1 if cx > px else -1
			var x_pos = int(px)
			while x_pos != int(cx):
				map_data[x_pos][int(py)] = 0
				x_pos += step_x
			
			var step_y = 1 if cy > py else -1
			var y_pos = int(py)
			while y_pos != int(cy):
				map_data[int(cx)][y_pos] = 0
				y_pos += step_y
		
		rooms.append({ "x": rx, "y": ry, "w": rw, "h": rh })
	
	# Player start in first room
	var first = rooms[0]
	player.x = first.x + first.w / 2
	player.y = first.y + first.h / 2
	player.floor = floor_num
	
	# Stairs in last room
	var last = rooms[-1]
	stair_x = last.x + last.w / 2
	stair_y = last.y + last.h / 2
	
	# Spawn enemies
	var enemy_count = min(4 + floor_num * 0.6, 10)
	for i in range(enemy_count):
		var ri = randi() % rooms.size()
		if ri == 0: ri = 1 if rooms.size() > 1 else 0
		var r = rooms[ri]
		var ex = r.x + 1 + randi() % (r.w - 2)
		var ey = r.y + 1 + randi() % (r.h - 2)
		
		var etype_idx = mini((floor_num - 1) / 4, ENEMY_TYPES.size() - 1)
		var hp = 8 + floor_num * 2
		var atk = 3 + floor_num
		var def = 1 + floor_num / 2
		
		enemies.append({
			"x": ex, "y": ey,
			"hp": hp, "max_hp": hp,
			"atk": atk, "def": def,
			"type": ENEMY_TYPES[etype_idx],
			"xp": 5 + floor_num * 2,
			"stun": 0,
			"is_boss": false
		})
		
		# Boss on multiples of 5
		if floor_num % 5 == 0 and i == enemy_count - 1:
			enemies[-1]["is_boss"] = true
			enemies[-1]["hp"] = 30 + floor_num * 5
			enemies[-1]["max_hp"] = 30 + floor_num * 5
			enemies[-1]["atk"] = 10 + floor_num * 3
			enemies[-1]["def"] = 5 + floor_num / 2
			enemies[-1]["xp"] = 50 + floor_num * 5
			enemies[-1]["x"] = stair_x
			enemies[-1]["y"] = stair_y - 1
	
	# Spawn civilians
	var civ_count = 1 + randi() % 3
	for i in range(civ_count):
		var ri = randi() % rooms.size()
		if ri == 0: ri = 1 if rooms.size() > 1 else 0
		var r = rooms[ri]
		var cx = r.x + 1 + randi() % (r.w - 2)
		var cy = r.y + 1 + randi() % (r.h - 2)
		var ctype = CIVILIAN_TYPES[randi() % CIVILIAN_TYPES.size()]
		civilians.append({ "x": cx, "y": cy, "type": ctype, "rescued": false })
	
	update_fov()
	update_explored()
	print("Floor ", floor_num, " generated with ", rooms.size(), " rooms, ", enemy_count, " enemies")

func update_fov():
	# Simple raycast FOV
	var px = player.x
	var py = player.y
	
	for x in range(MAP_WIDTH):
		for y in range(MAP_HEIGHT):
			visible[x][y] = false
	
	var radius = FOV_RADIUS
	for dx in range(-radius, radius + 1):
		for dy in range(-radius, radius + 1):
			if dx * dx + dy * dy > radius * radius:
				continue
			var tx = px + dx
			var ty = py + dy
			if tx < 0 or tx >= MAP_WIDTH or ty < 0 or ty >= MAP_HEIGHT:
				continue
			
			# Simple LOS check
			var blocked = false
			var steps = max(abs(dx), abs(dy))
			for s in range(1, steps + 1):
				var lx = px + round(dx * s / float(steps))
				var ly = py + round(dy * s / float(steps))
				if lx == tx and ly == ty:
					break
				if map_data[lx][ly] == 1:
					blocked = true
					break
			
			if not blocked or (abs(dx) <= 1 and abs(dy) <= 1):
				visible[tx][ty] = true

func update_explored():
	for x in range(MAP_WIDTH):
		for y in range(MAP_HEIGHT):
			if visible[x][y]:
				explored[x][y] = true

func check_level_up():
	var xp_needed = 20 + player.level * 15 + pow(player.level, 1.5) * 2
	while player.xp >= xp_needed:
		player.xp -= xp_needed
		player.level += 1
		player.max_hp += 5
		player.hp = player.max_hp
		player.atk += 2
		player.def += 1
		add_message("LEVEL UP! Now " + RANKS[mini(player.level, RANKS.size() - 1)], Color("#44dd44"))
		
		# Grant warrant
		if player.warrants.size() < 10:
			var warrant_names = [
				"Lathi Mastery", "FIR Filing", "Handcuff Slam", "Crowd Control",
				"Body Armor", "Solidarity", "Beat Patrol", "Tip-Off Network", "Baton Charge", "Honorary Medal"
			]
			player.warrants.append(warrant_names[player.warrants.size()])
			add_message("New Warrant: " + warrant_names[player.warrants.size() - 1], Color("#D4A843"))
		
		xp_needed = 20 + player.level * 15 + pow(player.level, 1.5) * 2

func add_message(text: String, color := Color("#cccccc")):
	message_queue.append({ "text": text, "color": color })
	if message_queue.size() > 10:
		message_queue.pop_front()
	print(text)

# Call this from _input or a button
func try_move(dx: int, dy: int):
	if not can_act or game_over:
		return
	
	var nx = player.x + dx
	var ny = player.y + dy
	
	if nx < 0 or nx >= MAP_WIDTH or ny < 0 or ny >= MAP_HEIGHT:
		return
	
	# Wall check
	if map_data[nx][ny] == 1:
		return
	
	# Enemy check — attack
	for e in enemies:
		if e.x == nx and e.y == ny and e.hp > 0:
			var dmg = max(1, player.atk + randi() % 3 - int(e.def))
			if e.stun > 0:
				dmg *= 2
			e.hp -= dmg
			add_message("Lathi strike! " + str(dmg) + " damage", Color("#ff4444"))
			if e.hp <= 0:
				player.xp += e.xp
				player.kills += 1
				if e.is_boss:
					add_message(BOSS_NAMES[player.floor] + " arrested!", Color("#44dd44"))
				add_message("Enemy defeated! +" + str(e.xp) + " XP", Color("#44dd44"))
			else:
				e.stun = max(0, e.stun - 1)
			player_turn()
			return
	
	# Stairs check
	if nx == stair_x and ny == stair_y:
		if player.floor >= MAX_FLOORS:
			game_over = true
			add_message("VICTORY! Commissioner arrested!", Color("#D4A843"))
			return
		player.floor += 1
		player.x = nx
		player.y = ny
		add_message("Descending to Floor " + str(player.floor), Color("#88ccff"))
		init_dungeon(player.floor)
		check_level_up()
		can_act = true
		return
	
	# Move
	player.x = nx
	player.y = ny
	turn_count += 1
	player_turn()

func player_turn():
	update_fov()
	update_explored()
	check_level_up()
	
	# Item pickup
	var to_remove = []
	for i in range(items.size()):
		if items[i].x == player.x and items[i].y == player.y:
			player.inventory.append(items[i].type)
			add_message("Picked up " + items[i].type, Color("#D4A843"))
			to_remove.append(i)
	for i in to_remove.reverse():
		items.remove_at(i)
	
	# Enemy phase
	enemy_phase()
	
	# HUD update
	update_hud()

func enemy_phase():
	var px = player.x
	var py = player.y
	
	for e in enemies:
		if e.hp <= 0:
			continue
		if e.stun > 0:
			e.stun -= 1
			continue
		
		var dist = abs(e.x - px) + abs(e.y - py)
		if dist <= 1:
			# Attack player
			var dmg = max(1, e.atk + randi() % 2 - int(player.def))
			player.hp -= dmg
			add_message("Enemy hits for " + str(dmg) + " damage", Color("#ff4444"))
			if player.hp <= 0:
				player.hp = 0
				game_over = true
				add_message("Fell in the line of duty...", Color("#ff3333"))
				return
			continue
		
		# Chase player
		var dx = sign(px - e.x)
		var dy = sign(py - e.y)
		
		var moved = false
		var tries = [[dx, 0], [0, dy], [dx, dy], [-dx, 0], [0, -dy]]
		for t in tries:
			var nx = e.x + t[0]
			var ny = e.y + t[1]
			if nx < 0 or nx >= MAP_WIDTH or ny < 0 or ny >= MAP_HEIGHT:
				continue
			if map_data[nx][ny] == 1:
				continue
			var occupied = false
			for e2 in enemies:
				if e2 != e and e2.x == nx and e2.y == ny and e2.hp > 0:
					occupied = true
					break
			if occupied:
				continue
			if nx == px and ny == py:
				continue
			e.x = nx
			e.y = ny
			moved = true
			break
	
	update_fov()
	update_explored()

func update_hud():
	# Will be connected to HUD elements
	pass

func _input(event):
	if event.is_action_pressed("move_up"):
		try_move(0, -1)
	elif event.is_action_pressed("move_down"):
		try_move(0, 1)
	elif event.is_action_pressed("move_left"):
		try_move(-1, 0)
	elif event.is_action_pressed("move_right"):
		try_move(1, 0)
	elif event.is_action_pressed("action_wait"):
		player_turn()
	elif event.is_action_pressed("action_interact"):
		rescue_civilian()
	elif event.is_action_pressed("action_inventory"):
		show_warrants()

func rescue_civilian():
	for c in civilians:
		if c.rescued:
			continue
		var dist = abs(c.x - player.x) + abs(c.y - player.y)
		if dist == 1:
			c.rescued = true
			player.civilians_rescued += 1
			add_message("Rescued " + CIVILIAN_NAMES[c.type] + "! " + CIVILIAN_BUFFS[c.type], Color("#44dd44"))
			player_turn()
			return
	add_message("No civilian adjacent to rescue.")

func show_warrants():
	# Placeholder — will show warrant panel
	print("Warrants: ", player.warrants)
